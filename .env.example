# ==============================================================================
# NESTJS BACKEND TEMPLATE CONFIGURATION
# ==============================================================================
# Base configuration for services scaffolded from this template.
# Designed for DDD architecture with built-in observability.

# ------------------------------------------------------------------------------
# APPLICATION CONFIG
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# API SETTINGS
# ------------------------------------------------------------------------------
API_VERSION=1
APP_NAME="NestJS Backend Template"
APP_DESCRIPTION="API Documentation"
# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# ------------------------------------------------------------------------------
# DATABASE CONFIG (Prisma)
# ------------------------------------------------------------------------------
# Supports PostgreSQL, MongoDB, etc. based on the chosen scaffold template.
DATABASE_URL="postgresql://user:password@localhost:5432/template_db?schema=public"

# ------------------------------------------------------------------------------
# CACHE CONFIG (Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# RATE LIMITING (Throttler)
# ------------------------------------------------------------------------------
# TTL in seconds
THROTTLE_TTL=60
# Maximum requests allowed per client within the TTL
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# DOCUMENTATION AUTHENTICATION
# ------------------------------------------------------------------------------
# Basic Auth credentials for /docs and /specs endpoints
DOCS_USER=admin
DOCS_PASS=admin

# ------------------------------------------------------------------------------
# OBSERVABILITY (Tracing & Metrics)
# ------------------------------------------------------------------------------
# Log level is automatically set by NODE_ENV (debug in dev, info in prod).

# Set to true to activate OpenTelemetry SDK for distributed tracing.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nestjs-backend-template
# OTLP collector endpoint for trace data (HTTP/JSON).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Port for the local Prometheus metrics scraper.
OTEL_PROMETHEUS_PORT=9464
